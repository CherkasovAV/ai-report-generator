# Ключ OpenAI или единый ключ шлюза (ProxyAPI и т.п.)
PROXY_API_KEY=
# Альтернативное имя того же ключа:
# API_KEY=

# Базовый URL OpenAI-совместимого API (полная строка с https://).
# ProxyAPI: https://api.proxyapi.ru/openai/v1
OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1

# Прямой ключ OpenAI (если задан — используется вместо PROXY_API_KEY)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Генерация превью в отчёте «дизайн сайта» (Images API).
# ProxyAPI: семейство gpt-image-*; ответ картинки — b64_json по умолчанию (параметр response_format не передаётся).
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024
# Для gpt-image-*: low | medium | high | auto
OPENAI_IMAGE_QUALITY=medium
# Режим «marketplace»: фон карточки всегда генерируется моделью gpt-image-1 (независимо от OPENAI_IMAGE_MODEL).
# Только для dall-e-3 на официальном API: standard | hd
# OPENAI_IMAGE_DALLE_QUALITY=standard
